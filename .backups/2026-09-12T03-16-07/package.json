{
  "name": "adadarsh23",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ad Adarsh's Music Portfolio",
  "author": "Ad Adarsh <adadarsh523@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adadarsh23/Profile-Website"
  },
  "browserslist": "defaults",
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "trailingComma": "es5",
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "vitest": {
    "test": {
      "environment": "jsdom"
    }
  },
  "vite": {
    "plugins": [
      "@vitejs/plugin-react",
      "vite-plugin-compression",
      "vite-plugin-sitemap",
      "vite-plugin-remove-console",
      "vite-plugin-pwa",
      "@vitejs/plugin-legacy"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "vite",
    "react",
    "frontend",
    "typescript",
    "web"
  ],
  "bugs": {
    "url": "https://github.com/adadarsh23/Profile-Website/issues"
  },
  "homepage": "https://github.com/adadarsh23/Profile-Website",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:check": "eslint src --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "gh-pages -d dist",
    "clean": "node -e \"['dist'].forEach(p=>fs.existsSync(p)&&fs.rmSync(p,{recursive:true,force:true}))\"",
    "clean:all": "node -e \"['node_modules','package-lock.json','dist'].forEach(p=>fs.existsSync(p)&&fs.rmSync(p,{recursive:true,force:true}))\" && npm install",
    "clean:cache": "npm cache clean --force",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:lighthouse": "node scripts/lighthouse-audit.js",
    "analyze": "vite build --mode analyze",
    "unused:check": "depcheck .",
    "unused:fix": "node scripts/unused-fix.mjs",
    "job": "node scripts/job.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/fiber": "^9.7.0",
    "@sentry/react": "^10.74.0",
    "@statsig/react-bindings": "^3.33.5",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "logrocket": "^12.3.0",
    "lucide-react": "^1.44.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.5",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-ga4": "^3.0.1",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.183.2",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.6",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chalk": "^6.0.0",
    "chrome-launcher": "^1.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.51.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild": true
  }
}
